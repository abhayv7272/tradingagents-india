# ================= TradingAgents India — FREE API keys =================
# 1) Gemini (sabse zaroori — 1500 free calls/day)
#    https://aistudio.google.com/apikey  -> "Create API key"
GOOGLE_API_KEY=

# 2) Groq (Llama models — battle mode partner, 1000 free calls/day)
#    https://console.groq.com/keys
GROQ_API_KEY=

# 3) OpenRouter (3rd battle model — ~50 free requests/day)
#    https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 4) Optional market-data fallback (daily OHLCV + quote cross-check)
#    https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# 5) Optional global macro series (Fed rate, US 10Y, dollar, Brent)
#    https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---------------- Optional model overrides (auto-detected by default) -------
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=qwen/qwen3-235b-a224:free

# ---------------- Optional settings -----------------------------------------
# BATTLE_MODE=auto          # auto | off
# DEBATE_ROUNDS=2
# RISK_ROUNDS=1
# REPORT_LANGUAGE=hinglish  # hinglish | english | hindi
# MOCK_LLM=0                # 1 = demo mode without keys
